# Copiez en .env.local (local) ou renseignez dans Vercel (Settings > Environment Variables). Jamais de secret dans Git.

# Projet Supabase (Project Settings > API) — clé anon/publishable UNIQUEMENT (jamais service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique de CE site (http://localhost:3000 en local ; https://erere.vercel.app en production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CAPTCHA Cloudflare Turnstile : désactivé par défaut (les formulaires fonctionnent sans)
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
